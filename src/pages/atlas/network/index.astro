---
import { sitePath } from '../../../lib/site-path';
import AtlasNetwork from '../../../components/AtlasNetwork.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { loadCatalog } from '../../../lib/catalog/load';

const catalog = await loadCatalog();
---

<BaseLayout
  title="Game Innovation Atlas"
  description="Learn About Games 站内的历史与创新观察维度，以可核查证据呈现游戏创新关系。"
>
  <section class="atlas-intro page-shell">
    <p class="plain-label"><a href={sitePath('atlas/')}>← 返回历史总览</a> · 精确年份与证据网络</p>
    <h1>Game Innovation Atlas</h1>
    <p class="lede">Learn About Games 站内的历史与创新观察维度</p>
    <p class="reference-note">
      这不是多条彼此隔离的品类时间线，而是一张可核查的全局网络。Roguelike 与 Metroidvania 只是证据透镜，只改变强调，不隐藏节点、不改位置，也不把后来的类别名倒灌到早期作品。
    </p>
  </section>

  <AtlasNetwork
    tags={catalog.atlasTags}
    evidence={catalog.atlasEvidence}
    nodes={catalog.atlasNodes}
    relations={catalog.atlasRelations}
    themes={catalog.atlasThemes}
  />
</BaseLayout>
