---
import CareerExplorer from '../../components/CareerExplorer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadCatalog } from '../../lib/catalog/load';

const catalog = await loadCatalog();
---

<BaseLayout title="职业方向" description="用公开依据理解职业与生产语境如何参考 PlayWithExperiences 的 EGDS；它是一种可讨论的视角，不是唯一答案或评分。">
  <CareerExplorer
    mapGroups={catalog.mapGroups}
    domains={catalog.domains}
    capabilities={catalog.capabilities}
    knowledgeTopics={catalog.knowledgeTopics}
    capabilityRelations={catalog.capabilityRelations}
    roleProfiles={catalog.roleProfiles}
    resources={catalog.resources}
  />
</BaseLayout>
