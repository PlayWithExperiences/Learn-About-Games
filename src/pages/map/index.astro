---
import MapExplorer from '../../components/MapExplorer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadCatalog } from '../../lib/catalog/load';

const {
  egdsFrameworkNodes,
  egdsFrameworkRelations,
  capabilities,
  knowledgeTopics,
  capabilityRelations,
} = await loadCatalog();
---

<BaseLayout title="能力地图" description="以 PlayWithExperiences 的 EGDS 作为可讨论、可修订的设计视角，理解设计如何成为结果。">
  <header class="map-intro page-shell" id="map-intro">
    <p class="plain-label">能力地图</p>
    <h1>从体验出发，理解设计如何成为结果。</h1>
    <p class="lede">本地图以 PlayWithExperiences 的 EGDS 为知识骨架，结合公开资料与行业实践持续修订。它是一种可讨论的设计视角，不是唯一标准答案。</p>
  </header>

  <div class="page-shell">
    <MapExplorer
      egdsFrameworkNodes={egdsFrameworkNodes}
      egdsFrameworkRelations={egdsFrameworkRelations}
      capabilities={capabilities}
      knowledgeTopics={knowledgeTopics}
      capabilityRelations={capabilityRelations}
    />
  </div>
</BaseLayout>
