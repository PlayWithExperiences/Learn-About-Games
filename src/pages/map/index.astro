---
import MapExplorer from '../../components/MapExplorer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadCatalog } from '../../lib/catalog/load';

const { mapGroups, domains, capabilities, knowledgeTopics, capabilityRelations } = await loadCatalog();
---

<BaseLayout title="能力地图" description="从知识地域进入 Learn About Games 的能力地图。">
  <header class="map-intro page-shell" id="map-intro">
    <p class="plain-label">能力地图</p>
    <h1>用领域建立方向，用能力选择行动。</h1>
    <p class="lede">{domains.length} 个领域构成开放地域，能力与知识议题是可进入的节点。关系说明协作与支持，不把地图改写成统一学习顺序。</p>
  </header>

  <div class="page-shell">
    <MapExplorer
      mapGroups={mapGroups}
      domains={domains}
      capabilities={capabilities}
      knowledgeTopics={knowledgeTopics}
      capabilityRelations={capabilityRelations}
    />
  </div>
</BaseLayout>
