---
import { getCollection, type CollectionEntry } from 'astro:content';

import ProjectDocContent from '../../components/ProjectDocContent.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'projectDocs'>;
}

export async function getStaticPaths() {
  const entries = await getCollection('projectDocs');

  return entries.map((entry) => ({
    params: { id: entry.id.replace(/\.md$/, '').toLowerCase() },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const title = entry.id.replace(/\.md$/, '');
const html = entry.rendered?.html;

if (html === undefined) {
  throw new Error(`Project document ${entry.id} was not rendered by Astro.`);
}
---

<BaseLayout title={title}>
  <article class="prose page-shell">
    <ProjectDocContent html={html} sourceFilePath={entry.filePath ?? entry.id} />
  </article>
</BaseLayout>
