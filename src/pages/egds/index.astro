---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sitePath } from '../../lib/site-path';

const currentModel = [
  {
    name: '情绪曲线',
    english: 'Emotional Curve',
    description: '观察一段体验随时间发生的情绪变化，而不是只看孤立的高点。',
  },
  {
    name: '情绪体验',
    english: 'Emotional Experiences',
    description: '把曲线拆成玩家能够辨认和描述的局部体验。',
  },
  {
    name: '主观感受',
    english: 'Subjective Feelings',
    description: '记录玩家如何感到紧张、好奇、安全、受挫或满足。',
  },
  {
    name: '客观原因',
    english: 'Objective Reasons',
    description: '追查规则、信息、节奏、空间与呈现如何共同造成这些感受。',
  },
  {
    name: '设计杠杆',
    english: 'Design Levers',
    description: '找到能够被调整、组合和验证的具体设计手段。',
  },
];

const practiceCycle = [
  {
    name: '感受',
    english: 'Perception',
    description: '先确认玩家实际经历了什么，不急于替体验下结论。',
  },
  {
    name: '理解',
    english: 'Rationalize',
    description: '为感受建立可讨论的解释，区分观察、推断和假设。',
  },
  {
    name: '解构',
    english: 'Deconstruct',
    description: '把体验拆到规则、反馈、叙事、空间和表现等可检查原因。',
  },
  {
    name: '重构',
    english: 'Reconstruct',
    description: '使用设计杠杆重新组织体验，并通过游玩证据继续修正。',
  },
];

const designLevers = [
  {
    name: '玩法与挑战',
    description: '规则、目标、选择、难度、反馈和行动空间。',
  },
  {
    name: '叙事',
    description: '情境、角色、事件、信息安排和玩家能动性。',
  },
  {
    name: '美学与表现',
    description: '视觉、声音、文字、动作和整体呈现方式。',
  },
];

const publishedArticles = [
  {
    date: '2024-04-13',
    title: '情感化游戏设计系统 0：从叙事结构出发',
    description: '从叙事结构与作品比较出发，记录 EGDS 最初的问题意识。',
    href: 'https://medill-east.github.io/2024/04/13/20240413-emotional-game-design-system-0-narrative-structure/',
  },
  {
    date: '2024-04-14',
    title: '情感化游戏设计系统 1：构建系统',
    description: '提出情绪曲线、局部体验、感受、机制与叙事之间的早期系统关系。',
    href: 'https://medill-east.github.io/2024/04/14/20240414-emotional-game-design-system-1-create-the-system/',
  },
  {
    date: '2024-04-28',
    title: '情感化游戏设计系统 2：探索感如何进入系统分析',
    description: '以探索感为例，把抽象感受追溯到玩法机制与内容呈现。',
    href: 'https://medill-east.github.io/2024/04/28/20240428-emotional-game-design-system-2-intrinsic-feeling-exploration',
  },
  {
    date: '2024-11-23',
    title: '情感化游戏设计系统 3：BOSS 战设计框架',
    description: '将方法应用到 BOSS 战，展示从体验目标到设计结构的具体案例。',
    href: 'https://medill-east.github.io/2024/11/23/20241123-emotional-game-design-system-3-boss-fight-design-structure',
  },
];
---

<BaseLayout
  title="EGDS｜情感化游戏设计系统"
  description="从 PlayWithExperiences 的当前 PKM 模型理解 EGDS，以及它与 Learn About Games 能力地图的关系。"
>
  <article class="egds-page">
    <header class="egds-page__intro page-shell">
      <p class="plain-label">PlayWithExperiences 方法</p>
      <h1>EGDS｜情感化游戏设计系统</h1>
      <p class="lede">从玩家真实感受到的体验出发，追查它为何发生，再把理解转化为可以调整和验证的设计行动。</p>
      <p>Digital Garden 是当前 EGDS 工作模型的主要来源。已经发布的文章保留了方法形成时的真实版本，但不反向限制现在的模型。</p>
      <div class="egds-page__intro-actions">
        <a class="text-link" href="#current-model">阅读当前模型</a>
        <a class="text-link" href={sitePath('map/')}>在能力地图中查看</a>
      </div>
    </header>

    <section class="egds-page__model page-shell" id="current-model" aria-labelledby="egds-current-model-heading">
      <div class="egds-page__section-copy">
        <h2 id="egds-current-model-heading">当前模型从体验结果追到设计原因。</h2>
        <p>这条链不是必须照抄的制作流程。它帮助设计者从整体体验逐层缩小问题，直到找到可以修改的设计杠杆。</p>
      </div>
      <ol class="egds-model-chain" data-egds-current-model>
        {currentModel.map((layer) => (
          <li>
            <span class="egds-model-chain__index" aria-hidden="true">{String(currentModel.indexOf(layer) + 1).padStart(2, '0')}</span>
            <strong>{layer.name}</strong>
            <span lang="en">{layer.english}</span>
            <p>{layer.description}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="egds-page__practice page-shell" aria-labelledby="egds-practice-heading">
      <div class="egds-page__section-copy">
        <h2 id="egds-practice-heading">把感受转成可以讨论的设计工作。</h2>
        <p>感受、理解、解构与重构是一组反复进行的工作动作。新证据会让设计者重新回到前面的动作。</p>
      </div>
      <ol class="egds-practice-cycle" data-egds-practice-cycle>
        {practiceCycle.map((step) => (
          <li>
            <strong>{step.name}</strong>
            <span lang="en">{step.english}</span>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="egds-page__levers page-shell" aria-labelledby="egds-levers-heading">
      <div class="egds-page__section-copy">
        <h2 id="egds-levers-heading">重构会同时使用多类设计杠杆。</h2>
        <p>三类入口可以共同作用于同一段体验。它们不是互斥标签，也不代表固定的部门边界。</p>
      </div>
      <ul class="egds-lever-list" data-egds-levers>
        {designLevers.map((lever) => (
          <li>
            <strong>{lever.name}</strong>
            <p>{lever.description}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="egds-page__map-relationship page-shell" aria-labelledby="egds-map-relationship-heading">
      <div class="egds-page__section-copy">
        <h2 id="egds-map-relationship-heading">EGDS 是地图的依据，但不等于整张地图。</h2>
        <p>Learn About Games 把作者方法延伸到生产、协作、产品与更广语境，因此需要明确三类实体各自表达什么。</p>
      </div>
      <dl class="egds-entity-boundaries">
        <div>
          <dt>EGDS Framework Node</dt>
          <dd>表达方法中的问题、阶段和结构，不参与个人进度。</dd>
        </div>
        <div>
          <dt>Capability</dt>
          <dd>表达可以通过实践逐步掌握、观察和复盘的能力。</dd>
        </div>
        <div>
          <dt>Knowledge Topic</dt>
          <dd>表达理解设计背景所需的知识议题，不伪装成可直接完成的能力。</dd>
        </div>
      </dl>
      <a class="text-link" href={sitePath('map/')}>打开基于 EGDS 组织的能力地图</a>
    </section>

    <section class="egds-page__history page-shell" data-egds-history aria-labelledby="egds-history-heading">
      <div class="egds-page__section-copy">
        <h2 id="egds-history-heading">已发布文章保存了方法的形成过程。</h2>
        <p>四篇文章记录的是方法形成时的真实版本。它们帮助读者理解概念如何出现，但当前定义以 PKM 为先。</p>
      </div>
      <div class="egds-history-grid">
        {publishedArticles.map((article) => (
          <article>
            <time datetime={article.date}>{article.date}</time>
            <h3><a href={article.href}>{article.title}</a></h3>
            <p>{article.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="egds-page__current-source page-shell" aria-labelledby="egds-current-source-heading">
      <div>
        <h2 id="egds-current-source-heading">当前模型继续在 Digital Garden 生长。</h2>
        <p>PKM 保存更细的概念页、案例、组织笔记和仍在修订的联系。本站只提供方法入口与稳定摘要，不镜像整个知识库。</p>
      </div>
      <a class="button-link" href="https://play-with-experiences-digital-garden.vercel.app/">打开当前 EGDS Digital Garden</a>
    </section>

    <aside class="egds-page__boundary page-shell" aria-labelledby="egds-boundary-heading">
      <h2 id="egds-boundary-heading">使用边界</h2>
      <p>EGDS 是 PlayWithExperiences 提出并持续修订的作者方法。它不是行业标准、资格认证、必修顺序、唯一学习路径或个人评分系统。</p>
    </aside>
  </article>
</BaseLayout>
