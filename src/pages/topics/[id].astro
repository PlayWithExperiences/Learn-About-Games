---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadCatalog } from '../../lib/catalog/load';
import { formatMediaType } from '../../lib/resource-display';
import { sitePath } from '../../lib/site-path';

export async function getStaticPaths() {
  const catalog = await loadCatalog();
  return catalog.knowledgeTopics.map((topic) => ({
    params: { id: topic.id },
    props: { topic, catalog },
  }));
}

const { topic, catalog } = Astro.props;
const frameworkNode = catalog.egdsFrameworkNodes.find(({ id }) => id === topic.frameworkNodeId);
if (!frameworkNode) throw new Error(`Missing EGDS framework node for topic ${topic.id}`);

const resourceTopics = catalog.resourceTopics.filter((entry) => entry.knowledgeTopicIds.includes(topic.id));
const resources = catalog.resources.filter((resource) => resource.knowledgeTopicIds.includes(topic.id));
---

<BaseLayout title={topic.name['zh-CN']} description={topic.summary['zh-CN']}>
  <article class="page-shell detail-page topic-detail-page">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href={sitePath('map/')}>能力地图</a>
      <span aria-hidden="true">/</span>
      <a href={`${sitePath('map/')}#egds-${frameworkNode.id}`}>{frameworkNode.name['zh-CN']}</a>
      <span aria-hidden="true">/</span>
      <span>知识议题</span>
    </nav>
    <p class="plain-label">知识议题</p>
    <h1>{topic.name['zh-CN']}</h1>
    <p class="lede">{topic.summary['zh-CN']}</p>

    <section aria-labelledby="related-resources-heading" data-node-resources>
      <h2 id="related-resources-heading">相关资源</h2>
      {resourceTopics.length > 0 && (
        <div class="detail-card-list">
          {resourceTopics.map((resourceTopic) => (
            <a
              class="detail-card"
              href={`${sitePath('resources/')}?resourceTopic=${resourceTopic.id}`}
              data-node-resource-topic-id={resourceTopic.id}
            >
              <span>主题资源集合</span>
              <h3>{resourceTopic.title['zh-CN']}</h3>
              <p>{resourceTopic.summary['zh-CN']}</p>
            </a>
          ))}
        </div>
      )}
      <a class="text-link" href={`${sitePath('resources/')}?knowledgeTopic=${topic.id}`}>
        在全部资源中继续筛选
      </a>
      {resources.length > 0 ? (
        <>
          <p class="detail-section-note">这些 Work Item 与当前知识议题直接关联，按目录顺序列出。</p>
          <ul class="compact-resource-list">
            {resources.map((resource) => {
              const source = catalog.sources.find(({ id }) => id === resource.sourceId);
              return (
                <li data-node-resource-id={resource.id}>
                  <a href={resource.canonicalUrl}><strong>{resource.title['zh-CN']}</strong></a>
                  <span>{source?.name['zh-CN']} · {formatMediaType(resource.mediaType)}</span>
                  <p>{resource.whyRelevant['zh-CN']}</p>
                </li>
              );
            })}
          </ul>
        </>
      ) : (
        <p>
          当前目录还没有与这个知识议题直接关联的 Work Item。
          {' '}<a href={sitePath('project/contributing/')}>查看贡献指南</a>
        </p>
      )}
    </section>
  </article>
</BaseLayout>
