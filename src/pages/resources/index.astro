---
import ResourceExplorer from '../../components/ResourceExplorer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadCatalog } from '../../lib/catalog/load';

const catalog = await loadCatalog();
---

<BaseLayout title="资源库" description="按可消费语言浏览具体游戏学习资源。">
  <div class="page-shell resource-page">
    <ResourceExplorer
      resources={catalog.resources}
      sources={catalog.sources}
      resourceTopics={catalog.resourceTopics}
      knowledgeTopics={catalog.knowledgeTopics}
      capabilities={catalog.capabilities}
    />
  </div>
</BaseLayout>
