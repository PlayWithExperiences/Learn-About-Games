---
import { sitePath } from '../lib/site-path';
import { ui } from '../i18n/ui';
import ThemeControl from '../components/ThemeControl.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = '一张公开、可修订的游戏知识与能力地图。',
} = Astro.props;

const navigation = [
  { label: ui['zh-CN'].expertiseMap, href: sitePath('map/') },
  { label: ui['zh-CN'].careerLenses, href: sitePath('careers/') },
  { label: ui['zh-CN'].learningResources, href: sitePath('resources/') },
  { label: ui['zh-CN'].innovationAtlas, href: sitePath('atlas/') },
  { label: ui['zh-CN'].about, href: sitePath('about/') },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <script is:inline>
      try {
        const preference = window.localStorage.getItem('learn-about-games:theme:v1');
        if (preference === 'light' || preference === 'dark') {
          document.documentElement.dataset.theme = preference;
        }
      } catch {
        // Storage is optional; CSS falls back to the system appearance.
      }
    </script>
    <title>{title} | Learn About Games</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href={sitePath()} aria-label="Learn About Games 首页">
          <span>Learn About Games</span>
          <small>by PlayWithExperiences</small>
        </a>
        <nav class="site-nav site-nav--desktop" aria-label="主导航">
          <ul>
            {navigation.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
        <div class="site-header__tools">
          <ThemeControl />
        </div>
        <details class="site-nav__compact">
          <summary>主导航</summary>
          <nav class="site-nav" aria-label="主导航">
            <ul>
              {navigation.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </nav>
        </details>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="page-shell site-footer__inner">
        <p>一张公开、可修订的参考地图。参考不是标准。</p>
        <a href={sitePath('project/readme/')}>项目说明</a>
      </div>
    </footer>
  </body>
</html>
