---
import ResourceTable from './ResourceTable.astro';
import type { Catalog } from '../lib/catalog/validate';
import { formatAccessModel, formatLanguage, formatMediaType } from '../lib/resource-display';
import { sitePath } from '../lib/site-path';

interface Props {
  resources: Catalog['resources'];
  sources: Catalog['sources'];
  resourceTopics: Catalog['resourceTopics'];
  knowledgeTopics: Catalog['knowledgeTopics'];
  capabilities: Catalog['capabilities'];
  title?: string;
  lede?: string;
}

const {
  resources,
  sources,
  resourceTopics,
  knowledgeTopics,
  capabilities,
  title = '按主题与事实浏览游戏学习资源',
  lede = '先选择想理解的主题，再按能力、语言、媒介、访问方式或 Source 缩小范围。这里没有固定顺序。',
} = Astro.props;

const languages = [...new Set(resources.flatMap((resource) => [
  resource.originalLanguage,
  ...resource.accessVersions.map(({ language }) => language),
]))];
const mediaTypes = [...new Set(resources.map(({ mediaType }) => mediaType))];
const accessModels = [...new Set(resources.flatMap(({ accessVersions }) =>
  accessVersions.map(({ accessModel }) => accessModel),
))];
---

<section class="resource-explorer" aria-labelledby="resource-list-title">
  <header class="resource-explorer__intro">
    <p class="plain-label">资源导航</p>
    <h1 id="resource-list-title">{title}</h1>
    <p class="lede">{lede}</p>
  </header>

  <nav class="resource-subnav" aria-label="成长资源入口">
    <a href={sitePath('resources/')} aria-current="page">资源表</a>
    <a href={sitePath('resources/sources/')}>来源</a>
  </nav>

  <nav class="resource-topic-index" aria-labelledby="resource-topic-index-title">
    <div>
      <p class="plain-label">主题入口</p>
      <h2 id="resource-topic-index-title">{resourceTopics.length} 个无顺序资源主题</h2>
    </div>
    <div class="resource-topic-index__links">
      {resourceTopics.map((topic) => (
        <a
          href={`${sitePath('resources/')}?resourceTopic=${topic.id}`}
          data-resource-topic-control
        >
          {topic.title['zh-CN']}
        </a>
      ))}
    </div>
  </nav>

  <fieldset class="resource-filter-panel">
    <legend>按事实筛选 Work Item</legend>
    <label class="resource-search-field">
      <span>搜索资源</span>
      <input
        type="search"
        name="q"
        aria-label="搜索资源"
        placeholder="标题、简介、来源……"
        autocomplete="off"
        data-resource-search
        disabled
      />
    </label>
    <div class="resource-filter-grid">
      <label>
        <span>资源主题</span>
        <select name="resourceTopic" aria-label="资源主题" data-resource-filter data-query-param="resourceTopic" disabled>
          <option value="all">全部主题</option>
          {resourceTopics.map((topic) => <option value={topic.id}>{topic.title['zh-CN']}</option>)}
        </select>
      </label>
      <label>
        <span>知识主题</span>
        <select name="knowledgeTopic" aria-label="知识主题" data-resource-filter data-query-param="knowledgeTopic" disabled>
          <option value="all">全部知识主题</option>
          {knowledgeTopics.map((topic) => <option value={topic.id}>{topic.name['zh-CN']}</option>)}
        </select>
      </label>
      <label>
        <span>能力</span>
        <select name="capability" aria-label="能力" data-resource-filter data-query-param="capability" disabled>
          <option value="all">全部能力</option>
          {capabilities.map((capability) => <option value={capability.id}>{capability.name['zh-CN']}</option>)}
        </select>
      </label>
      <label>
        <span>可消费语言</span>
        <select name="language" aria-label="可消费语言" data-resource-filter data-query-param="language" disabled>
          <option value="all">全部语言</option>
          {languages.map((language) => <option value={language}>{formatLanguage(language)}</option>)}
        </select>
      </label>
      <label>
        <span>媒介</span>
        <select name="mediaType" aria-label="媒介" data-resource-filter data-query-param="mediaType" disabled>
          <option value="all">全部媒介</option>
          {mediaTypes.map((mediaType) => <option value={mediaType}>{formatMediaType(mediaType)}</option>)}
        </select>
      </label>
      <label>
        <span>访问方式</span>
        <select name="accessModel" aria-label="访问方式" data-resource-filter data-query-param="accessModel" disabled>
          <option value="all">全部访问方式</option>
          {accessModels.map((accessModel) => <option value={accessModel}>{formatAccessModel(accessModel)}</option>)}
        </select>
      </label>
      <label>
        <span>Source</span>
        <select name="source" aria-label="Source" data-resource-filter data-query-param="source" disabled>
          <option value="all">全部 Source</option>
          {sources.map((source) => <option value={source.id}>{source.name['zh-CN']}</option>)}
        </select>
      </label>
    </div>
    <noscript>
      <p class="script-required-note">启用 JavaScript 后可以搜索、组合筛选或展开全部；当前可逐个展开 {resourceTopics.length} 个资源主题，全部 {resources.length} 条 Work Item 均可访问。</p>
    </noscript>
  </fieldset>

  <p id="resource-result-count" role="status" aria-live="polite">
    共 {resources.length} 条 Work Item
  </p>

  <p class="resource-empty-state" hidden>没有同时符合这些事实条件的 Work Item。可以移除一个筛选条件再看。</p>

  <ResourceTable resources={resources} sources={sources} resourceTopics={resourceTopics} />
</section>

<script>
  const controls = Array.from(document.querySelectorAll<HTMLSelectElement>('[data-resource-filter]'));
  const searchInput = document.querySelector<HTMLInputElement>('[data-resource-search]');
  const workItems = Array.from(document.querySelectorAll<HTMLElement>('[data-result-kind="work-item"]'));
  const groups = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-resource-group]'));
  const tableControls = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-resource-table-control]'));
  const resultCount = document.querySelector<HTMLElement>('#resource-result-count');
  const emptyState = document.querySelector<HTMLElement>('.resource-empty-state');

  const queryParamByFilter = {
    resourceTopic: 'resourceTopic',
    knowledgeTopic: 'knowledgeTopic',
    capability: 'capability',
    language: 'language',
    mediaType: 'mediaType',
    accessModel: 'accessModel',
    source: 'source',
  } as const;

  function hasListValue(value: string | undefined, expected: string) {
    return (value?.split(' ') ?? []).includes(expected);
  }

  function normalizeSearchText(value: string) {
    return value.normalize('NFKC').trim().toLocaleLowerCase();
  }

  function workItemMatches(item: HTMLElement, values: Record<string, string>) {
    return (
      (!values.search || normalizeSearchText(item.dataset.searchText ?? '').includes(normalizeSearchText(values.search)))
      &&
      (values.resourceTopic === 'all' || hasListValue(item.dataset.resourceTopics, values.resourceTopic))
      && (values.knowledgeTopic === 'all' || hasListValue(item.dataset.knowledgeTopics, values.knowledgeTopic))
      && (values.capability === 'all' || hasListValue(item.dataset.capabilities, values.capability))
      && (values.language === 'all' || hasListValue(item.dataset.languages, values.language))
      && (values.mediaType === 'all' || item.dataset.mediaType === values.mediaType)
      && (values.accessModel === 'all' || hasListValue(item.dataset.accessModels, values.accessModel))
      && (values.source === 'all' || item.dataset.sourceId === values.source)
    );
  }

  function valuesFromControls() {
    return {
      search: searchInput?.value ?? '',
      ...Object.fromEntries(controls.map((control) => [control.name, control.value])),
    };
  }

  function updateResults() {
    if (!resultCount) return;

    const values = valuesFromControls();
    const visibleWorkItems = workItems.filter((item) => {
      const visible = workItemMatches(item, values);
      item.hidden = !visible;
      return visible;
    });
    const filtersActive = Object.entries(values).some(([key, value]) =>
      key === 'search' ? value.length > 0 : value !== 'all',
    );
    for (const group of groups) {
      const matchingCount = workItems.filter((item) =>
        item.closest<HTMLElement>('[data-resource-group]') === group && !item.hidden,
      ).length;
      const count = group.querySelector<HTMLElement>('[data-resource-group-matching-count]');
      if (count) count.textContent = `${matchingCount} 条 Work Item`;
      group.hidden = filtersActive && matchingCount === 0;
      if (filtersActive) group.open = matchingCount > 0;
    }

    resultCount.textContent = `共 ${visibleWorkItems.length} 条 Work Item`;
    if (emptyState) emptyState.hidden = visibleWorkItems.length > 0;
  }

  function syncControlsFromUrl() {
    const params = new URLSearchParams(window.location.search);
    if (searchInput) searchInput.value = params.get('q') ?? '';
    for (const control of controls) {
      const paramName = queryParamByFilter[control.name as keyof typeof queryParamByFilter];
      const requestedValue = paramName ? params.get(paramName) : null;
      control.value = requestedValue && Array.from(control.options).some(({ value }) => value === requestedValue)
        ? requestedValue
        : 'all';
    }
  }

  function writeUrlFromControls() {
    const url = new URL(window.location.href);
    const search = searchInput?.value.trim() ?? '';
    if (search) url.searchParams.set('q', search);
    else url.searchParams.delete('q');
    for (const control of controls) {
      const paramName = queryParamByFilter[control.name as keyof typeof queryParamByFilter];
      if (!paramName) continue;
      if (control.value === 'all') {
        url.searchParams.delete(paramName);
      } else {
        url.searchParams.set(paramName, control.value);
      }
    }
    window.history.pushState({}, '', url);
  }

  for (const control of controls) {
    control.disabled = false;
    control.addEventListener('change', () => {
      writeUrlFromControls();
      updateResults();
    });
  }

  if (searchInput) {
    searchInput.disabled = false;
    searchInput.addEventListener('input', () => {
      writeUrlFromControls();
      updateResults();
    });
  }

  for (const control of tableControls) {
    control.disabled = false;
    control.addEventListener('click', () => {
      const open = control.dataset.resourceTableControl === 'expand';
      for (const group of groups) {
        if (!group.hidden) group.open = open;
      }
    });
  }

  function restoreFromUrl() {
    syncControlsFromUrl();
    updateResults();
  }

  window.addEventListener('popstate', restoreFromUrl);
  window.addEventListener('pageshow', restoreFromUrl);
  restoreFromUrl();
</script>
