---
import type { Catalog } from '../lib/catalog/validate';
import {
  formatAccessVersion,
  formatExternalSignal,
  formatMediaType,
  formatRegionRestriction,
} from '../lib/resource-display';

interface Props {
  resources: Catalog['resources'];
  sources: Catalog['sources'];
  title?: string;
  lede?: string;
}

const {
  resources,
  sources,
  title = '按可消费版本浏览 Work Item',
  lede = 'Source 是发布者或创作者；Work Item 是可直接学习的一条具体内容。',
} = Astro.props;

type AccessVersion = Catalog['resources'][number]['accessVersions'][number];

function groupAccessVersions(versions: AccessVersion[]) {
  return versions.reduce<{ url: string; versions: AccessVersion[] }[]>((groups, version) => {
    const group = groups.find(({ url }) => url === version.url);
    if (group) {
      group.versions.push(version);
    } else {
      groups.push({ url: version.url, versions: [version] });
    }
    return groups;
  }, []);
}
---

<section class="resource-explorer" aria-labelledby="resource-list-title">
  <div class="resource-explorer__controls">
    <div>
      <p class="plain-label">资源导航</p>
      <h1 id="resource-list-title">{title}</h1>
      <p class="lede">{lede}</p>
    </div>
    <label>
      <span>可消费语言</span>
      <select id="resource-language-filter" name="language" disabled>
        <option value="all">All</option>
        <option value="zh-CN">zh-CN</option>
        <option value="en">en</option>
      </select>
      <noscript><span class="script-required-note">启用 JavaScript 后可以按可消费语言筛选；当前列出全部 Work Item。</span></noscript>
    </label>
  </div>

  <p id="resource-result-count" role="status" aria-live="polite">共 {resources.length} 条 Work Item</p>

  <div class="resource-list">
    {resources.map((resource) => {
      const source = sources.find(({ id }) => id === resource.sourceId);
      const languages = resource.accessVersions.map(({ language }) => language).join(' ');
      const accessVersionsByUrl = groupAccessVersions(resource.accessVersions);

      return (
        <article class="resource-card" data-languages={languages}>
          <p class="resource-card__label">Work Item</p>
          <h2>{resource.title['zh-CN']}</h2>
          <p>{resource.summary['zh-CN']}</p>
          <p><strong>关联说明：</strong>{resource.whyRelevant['zh-CN']}</p>
          {source && (
            <p class="resource-card__source">
              <span>Source</span>
              <a href={source.homepage}>{source.name['zh-CN']}</a>
            </p>
          )}
          <dl class="resource-card__meta">
            <div><dt>媒介</dt><dd>{formatMediaType(resource.mediaType)}</dd></div>
            <div><dt>原始语言</dt><dd>{resource.originalLanguage}</dd></div>
          </dl>
          <ul class="access-version-list" aria-label={`${resource.title['zh-CN']} 的访问版本`}>
            {accessVersionsByUrl.map((group) => (
              <li>
                <a href={group.url}>{resource.title['zh-CN']}</a>
                <ul class="access-version-list__metadata">
                  {group.versions.map((version) => (
                    <>
                      <li>{formatAccessVersion(version)}</li>
                      {version.regionRestrictions?.map((restriction) => (
                        <li>{formatRegionRestriction(restriction)}</li>
                      ))}
                    </>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
          {resource.externalSignals && resource.externalSignals.length > 0 && (
            <ul aria-label={`${resource.title['zh-CN']} 的外部观察`}>
              {resource.externalSignals.map((signal) => (
                <li><a href={signal.url}>{formatExternalSignal(signal)}</a></li>
              ))}
            </ul>
          )}
          {source?.externalSignals && source.externalSignals.length > 0 && (
            <ul aria-label={`${source.name['zh-CN']} 的外部观察`}>
              {source.externalSignals.map((signal) => (
                <li><a href={signal.url}>{formatExternalSignal(signal)}</a></li>
              ))}
            </ul>
          )}
        </article>
      );
    })}
  </div>
</section>

<script>
  const select = document.querySelector<HTMLSelectElement>('#resource-language-filter');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.resource-card'));
  const resultCount = document.querySelector<HTMLElement>('#resource-result-count');

  if (select) {
    select.disabled = false;
  }

  function updateResources() {
    if (!select || !resultCount) return;

    const language = select.value;
    const visibleCards = cards.filter((card) => {
      const availableLanguages = card.dataset.languages?.split(' ') ?? [];
      const isVisible = language === 'all' || availableLanguages.includes(language);
      card.hidden = !isVisible;
      return isVisible;
    });

    resultCount.textContent = `共 ${visibleCards.length} 条 Work Item`;
  }

  select?.addEventListener('change', updateResources);
  window.addEventListener('pageshow', updateResources);
</script>
