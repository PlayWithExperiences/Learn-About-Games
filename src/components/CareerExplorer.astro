---
import CareerLensControl from './CareerLensControl.astro';
import type { Catalog } from '../lib/catalog/validate';

interface Props {
  capabilities: Catalog['capabilities'];
  roleProfiles: Catalog['roleProfiles'];
  resources: Catalog['resources'];
  mapTargetId: string;
}

const props = Astro.props;
---

<CareerLensControl {...props}>
  <slot />
</CareerLensControl>
