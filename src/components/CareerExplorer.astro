---
import CapabilityMap from './CapabilityMap.astro';
import { projectCareerLens, careerLensPriorities } from '../lib/career-lens';
import { sitePath } from '../lib/site-path';
import type { Catalog } from '../lib/catalog/validate';

interface Props {
  mapGroups: Catalog['mapGroups'];
  domains: Catalog['domains'];
  egdsFrameworkNodes: Catalog['egdsFrameworkNodes'];
  egdsFrameworkRelations: Catalog['egdsFrameworkRelations'];
  capabilities: Catalog['capabilities'];
  knowledgeTopics: Catalog['knowledgeTopics'];
  capabilityRelations: Catalog['capabilityRelations'];
  roleProfiles: Catalog['roleProfiles'];
  resources: Catalog['resources'];
}

const {
  egdsFrameworkNodes,
  egdsFrameworkRelations,
  capabilities,
  knowledgeTopics,
  capabilityRelations,
  roleProfiles,
  resources,
} = Astro.props;

const capabilityById = new Map(capabilities.map((capability) => [capability.id, capability]));
const directResourceCountByCapabilityId = new Map(
  capabilities.map((capability) => [
    capability.id,
    resources.filter((resource) => resource.capabilityIds.includes(capability.id)).length,
  ]),
);
const priorityLabels = {
  core: '核心',
  important: '重要',
  suggested: '建议了解',
} as const;
const responsibilityLabels = {
  execute: '亲自执行',
  contribute: '协作贡献',
  decide: '判断',
  direct: '指导',
} as const;
const profileOrder = ['aaa-game-designer', 'aaa-creative-director', 'indie-solo-developer'];
const profileViews = [...roleProfiles].sort(
  (left, right) => profileOrder.indexOf(left.id) - profileOrder.indexOf(right.id),
).map((profile) => ({
  profile,
  projection: projectCareerLens(capabilities, profile),
}));
const lensPayload = profileViews.map(({ profile, projection }) => ({
  profileId: profile.id,
  nodes: projection.nodes,
}));
const serializedLensPayload = JSON.stringify(lensPayload).replaceAll('<', '\\u003c');
const displaySourceTitle = (title: string) => title.replace(/\s+[—–]\s+/g, ': ');
---

<section class="career-explorer page-shell" data-career-explorer>
  <header class="career-explorer__intro">
    <p class="plain-label">职业方向</p>
    <h1>把职业语境叠加到同一张地图。</h1>
    <p class="lede">选择一个生产语境与岗位，观察公开资料中常被提及的关注范围。全部能力始终保留，个人实践记录与这里彼此独立。</p>
  </header>

  <fieldset class="career-lens-control" aria-describedby="career-lens-context">
    <legend>选择参考职业画像</legend>
    <p id="career-lens-context">每个画像都只是可复核的参考分布。团队结构、项目阶段与个人目标会改变实际责任。</p>
    <div class="career-lens-control__choices">
      {profileViews.map(({ profile }) => (
        <button
          type="button"
          data-career-lens-button
          data-profile-id={profile.id}
          aria-pressed="false"
          disabled
        >{profile.title['zh-CN']}</button>
      ))}
    </div>
    <div class="career-lens-control__footer">
      <p data-career-status aria-live="polite">当前显示完整能力地图，尚未应用职业画像。</p>
      <button type="button" data-career-clear disabled>清除职业画像</button>
    </div>
    <noscript>
      <p class="script-required-note">启用 JavaScript 后可以应用或清除职业画像；完整地图与公开依据仍可阅读。</p>
    </noscript>
  </fieldset>

  <section class="career-summaries" aria-labelledby="career-summary-title">
    <div class="career-summaries__heading">
      <p class="plain-label">画像摘要</p>
      <h2 id="career-summary-title">从关注范围直接进入地图与资源</h2>
      <p>数量只统计 catalog 中与该能力直接关联的 Work Item，不代表内容质量或能力重要程度。</p>
    </div>

    {profileViews.map(({ profile, projection }) => (
      <section class="career-summary" data-career-summary={profile.id} hidden>
        <header>
          <h3>{profile.title['zh-CN']}</h3>
          <p>{profile.basis['zh-CN']}</p>
        </header>
        <div class="career-summary__groups">
          {careerLensPriorities.map((priority) => (
            <section data-career-summary-group={priority}>
              <h4>{priorityLabels[priority]}</h4>
              <ul>
                {projection.groups[priority].map((mappedNode) => {
                  const capability = capabilityById.get(mappedNode.capabilityId);
                  if (!capability) return null;
                  const resourceCount = directResourceCountByCapabilityId.get(capability.id) ?? 0;
                  return (
                    <li data-career-summary-item={capability.id}>
                      <div class="career-summary-item__facts">
                        <strong>{capability.name['zh-CN']}</strong>
                        <span>{responsibilityLabels[mappedNode.responsibility]}</span>
                        <span>直接相关 Work Item {resourceCount} 条</span>
                      </div>
                      <div class="career-summary-item__actions">
                        <button type="button" data-focus-capability={capability.id} disabled>在地图中聚焦</button>
                        <a href={sitePath(`capabilities/${capability.id}/`)}>能力详情</a>
                        <a href={`${sitePath('resources/')}?capability=${capability.id}`}>相关资源</a>
                      </div>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
      </section>
    ))}
  </section>

  <div class="career-map" aria-label="职业画像覆盖的能力地图">
    <CapabilityMap
      egdsFrameworkNodes={egdsFrameworkNodes}
      egdsFrameworkRelations={egdsFrameworkRelations}
      capabilities={capabilities}
      knowledgeTopics={knowledgeTopics}
      capabilityRelations={capabilityRelations}
    />
  </div>

  <section class="career-evidence-index" aria-labelledby="career-evidence-title">
    <div class="career-evidence-index__heading">
      <p class="plain-label">公开依据</p>
      <h2 id="career-evidence-title">查看画像来自哪里，也看它不适用于哪里</h2>
      <p>来源用于说明画像的取材范围。公开岗位和行业材料都只能代表具体组织、项目与时间点。</p>
    </div>

    {profileViews.map(({ profile }) => (
      <details class="career-evidence" data-career-evidence={profile.id}>
        <summary>{profile.title['zh-CN']}</summary>
        <div class="career-evidence__body">
          <section>
            <h3>依据说明</h3>
            <p>{profile.basis['zh-CN']}</p>
          </section>
          <section class="career-evidence__caveat">
            <h3>适用边界</h3>
            <p>{profile.caveats['zh-CN']}</p>
          </section>
          <p class="career-evidence__reviewed">最近复核：{profile.reviewedAt}</p>
          <section class="career-evidence__sources">
            <h3>来源条目</h3>
            <ul>
              {profile.basisLinks.map((basisLink) => (
                <li>
                  <a href={basisLink.url}>{displaySourceTitle(basisLink.title['zh-CN'])}</a>
                  <span>{basisLink.sourceNote['zh-CN']}</span>
                </li>
              ))}
            </ul>
          </section>
        </div>
      </details>
    ))}
  </section>

  <script is:inline type="application/json" data-career-lens-data set:html={serializedLensPayload}></script>
</section>

<script>
  type CareerNode = {
    capabilityId: string;
    priority: 'core' | 'important' | 'suggested' | 'unlisted';
    responsibility?: 'execute' | 'contribute' | 'decide' | 'direct';
  };

  type CareerProjection = {
    profileId: string;
    nodes: CareerNode[];
  };

  const explorer = document.querySelector<HTMLElement>('[data-career-explorer]');
  const payloadElement = explorer?.querySelector<HTMLScriptElement>('[data-career-lens-data]');

  if (explorer && payloadElement) {
    const projections = JSON.parse(payloadElement.textContent ?? '[]') as CareerProjection[];
    const lensButtons = Array.from(explorer.querySelectorAll<HTMLButtonElement>('[data-career-lens-button]'));
    const clearButton = explorer.querySelector<HTMLButtonElement>('[data-career-clear]');
    const status = explorer.querySelector<HTMLElement>('[data-career-status]');
    const careerNodes = Array.from(explorer.querySelectorAll<HTMLElement>('[data-career-node]'));
    const summaries = Array.from(explorer.querySelectorAll<HTMLElement>('[data-career-summary]'));
    const evidenceItems = Array.from(explorer.querySelectorAll<HTMLDetailsElement>('[data-career-evidence]'));
    const focusButtons = Array.from(explorer.querySelectorAll<HTMLButtonElement>('[data-focus-capability]'));
    const roleLabels = {
      core: '核心',
      important: '重要',
      suggested: '建议了解',
    } as const;

    const clearNodeState = () => {
      careerNodes.forEach((node) => {
        delete node.dataset.rolePriority;
        delete node.dataset.roleResponsibility;
        delete node.dataset.roleState;
        const label = node.querySelector<HTMLElement>('[data-role-label]');
        if (label) {
          label.hidden = true;
          label.textContent = '';
        }
      });
    };

    const applyProjection = (profileId: string) => {
      const projection = projections.find((item) => item.profileId === profileId);
      const selectedButton = lensButtons.find((button) => button.dataset.profileId === profileId);
      if (!projection || !selectedButton) return;

      const projectedNodeById = new Map(projection.nodes.map((node) => [node.capabilityId, node]));
      clearNodeState();
      careerNodes.forEach((node) => {
        const capabilityId = node.dataset.capabilityId;
        const projectedNode = capabilityId ? projectedNodeById.get(capabilityId) : undefined;
        if (!projectedNode || projectedNode.priority === 'unlisted') {
          node.dataset.roleState = 'unlisted';
          return;
        }

        node.dataset.roleState = 'mapped';
        node.dataset.rolePriority = projectedNode.priority;
        if (projectedNode.responsibility) {
          node.dataset.roleResponsibility = projectedNode.responsibility;
        }
        const label = node.querySelector<HTMLElement>('[data-role-label]');
        if (label) {
          label.textContent = roleLabels[projectedNode.priority];
          label.hidden = false;
        }
      });

      lensButtons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button === selectedButton));
      });
      summaries.forEach((summary) => {
        summary.hidden = summary.dataset.careerSummary !== profileId;
      });
      evidenceItems.forEach((item) => {
        item.open = item.dataset.careerEvidence === profileId;
      });
      if (status) status.textContent = `已应用 ${selectedButton.textContent?.trim() ?? ''}。地图仍保留全部能力。`;
      if (clearButton) clearButton.disabled = false;
    };

    const clearProjection = () => {
      clearNodeState();
      lensButtons.forEach((button) => button.setAttribute('aria-pressed', 'false'));
      summaries.forEach((summary) => { summary.hidden = true; });
      evidenceItems.forEach((item) => { item.open = false; });
      if (status) status.textContent = '当前显示完整能力地图，尚未应用职业画像。';
      if (clearButton) clearButton.disabled = true;
    };

    lensButtons.forEach((button) => {
      button.disabled = false;
      button.addEventListener('click', () => {
        const profileId = button.dataset.profileId;
        if (profileId) applyProjection(profileId);
      });
    });

    focusButtons.forEach((button) => {
      button.disabled = false;
      button.addEventListener('click', () => {
        const capabilityId = button.dataset.focusCapability;
        if (!capabilityId) return;
        const targets = Array.from(
          explorer.querySelectorAll<HTMLElement>(`[data-career-focus-target][data-capability-id="${capabilityId}"]`),
        );
        const target = targets.find((candidate) => candidate.getClientRects().length > 0);
        const previousScrollBehavior = document.documentElement.style.scrollBehavior;
        document.documentElement.style.scrollBehavior = 'auto';
        target?.focus();
        target?.scrollIntoView({ block: 'center', inline: 'nearest' });
        document.documentElement.style.scrollBehavior = previousScrollBehavior;
      });
    });

    clearButton?.addEventListener('click', clearProjection);
    explorer.dataset.enhanced = 'true';
  }
</script>
