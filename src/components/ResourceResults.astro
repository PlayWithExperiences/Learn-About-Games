---
import type { Catalog } from '../lib/catalog/validate';
import {
  formatAccessModel,
  formatLanguage,
  formatMediaType,
  formatPresentationMode,
  formatRegionRestriction,
  externalObservationCopy,
  getResourceRelevanceDisplay,
  formatSourceKind,
  formatVersionRelation,
} from '../lib/resource-display';
import { sitePath } from '../lib/site-path';

interface Props {
  resources: Catalog['resources'];
  sources: Catalog['sources'];
  showSources?: boolean;
  showWorkItems?: boolean;
  showHeading?: boolean;
}

const { resources, sources, showSources = false, showWorkItems = true, showHeading = true } = Astro.props;
const workCountBySource = new Map(
  sources.map((source) => [
    source.id,
    resources.filter(({ sourceId }) => sourceId === source.id).length,
  ]),
);
---

{showSources && (
  <section class="source-directory" aria-labelledby="source-directory-title">
    <div class="result-section-heading">
      <p class="plain-label">Source</p>
      <h2 id="source-directory-title">发布者、创作者与资料站</h2>
      <p>Source 是内容的发布实体；它不会与同一域名下的具体 Work Item 合并。</p>
    </div>
    <div class="source-result-list">
      {sources.map((source) => (
        <article
          class="source-result"
          data-result-kind="source"
          data-result-id={source.id}
          data-source-id={source.id}
        >
          <div class="source-result__identity">
            Source · {formatSourceKind(source.kind)}
          </div>
          <div class="source-result__main" data-source-row-main>
            <h3><a href={sitePath(`sources/${source.id}/`)}>{source.name['zh-CN']}</a></h3>
            <p>{source.summary['zh-CN']}</p>
          </div>
          <dl class="source-result__facts" data-source-row-facts>
            <div><dt>语言</dt><dd>{source.languages.map(formatLanguage).join('、')}</dd></div>
            <div><dt>Work Item</dt><dd>{workCountBySource.get(source.id) ?? 0}</dd></div>
          </dl>
        </article>
      ))}
    </div>
  </section>
)}

{showWorkItems && (
<section class="work-item-directory" aria-label={showHeading ? undefined : 'Work Item'}>
  {showHeading && (
    <div class="result-section-heading">
      <p class="plain-label">Work Item</p>
      <h2 id="work-item-directory-title">可直接阅读、观看或收听的内容</h2>
      <p>{externalObservationCopy.directoryNote}</p>
    </div>
  )}

  <div class="work-item-result-list">
    {resources.map((resource) => {
      const source = sources.find(({ id }) => id === resource.sourceId);
      const relevanceDisplay = getResourceRelevanceDisplay(
        resource.summary['zh-CN'],
        resource.whyRelevant?.['zh-CN'],
      );
      const searchText = [
        resource.title['zh-CN'],
        resource.title.en,
        resource.summary['zh-CN'],
        resource.summary.en,
        resource.whyRelevant?.['zh-CN'],
        resource.whyRelevant?.en,
        source?.name['zh-CN'],
        source?.name.en,
      ].filter((value): value is string => Boolean(value)).join(' ');
      const languages = [...new Set([
        resource.originalLanguage,
        ...resource.accessVersions.map(({ language }) => language),
      ])];
      const accessModels = [...new Set(resource.accessVersions.map(({ accessModel }) => accessModel))];

      return (
        <article
          class="work-item-result"
          data-result-kind="work-item"
          data-result-id={resource.id}
          data-source-id={resource.sourceId}
          data-resource-topics={resource.resourceTopicIds.join(' ')}
          data-knowledge-topics={resource.knowledgeTopicIds.join(' ')}
          data-capabilities={resource.capabilityIds.join(' ')}
          data-languages={languages.join(' ')}
          data-media-type={resource.mediaType}
          data-access-models={accessModels.join(' ')}
          data-search-text={searchText}
        >
          <div class="work-item-result__index" aria-hidden="true">Work Item</div>
          <div class="work-item-result__main" data-work-row-main>
            <h3>{resource.title['zh-CN']}</h3>
            {source && <p>Source：<a href={sitePath(`sources/${source.id}/`)}>{source.name['zh-CN']}</a></p>}
          </div>
          <dl class="work-item-result__facts" data-work-row-facts>
            <div><dt>媒介</dt><dd>{formatMediaType(resource.mediaType)}</dd></div>
            <div><dt>原始语言</dt><dd>{formatLanguage(resource.originalLanguage)}</dd></div>
            <div><dt>可消费语言</dt><dd>{languages.map(formatLanguage).join('、')}</dd></div>
          </dl>
          <div class="work-item-result__access" data-work-row-access>
            <a class="work-item-result__canonical" href={resource.canonicalUrl}>打开资源原页</a>
            <span>{accessModels.map(formatAccessModel).join('、')}</span>
          </div>
          <details class="work-item-result__more">
            <summary>{resource.externalSignals?.length ? externalObservationCopy.disclosure : '查看访问版本'}</summary>
            <div class="work-item-result__more-body">
              <ul class="access-version-list" aria-label={`${resource.title['zh-CN']} 的访问版本`}>
                {resource.accessVersions.map((version) => (
                  <li>
                    <div class="access-version-list__facts">
                      <span>{formatLanguage(version.language)}</span>
                      <span>{formatVersionRelation(version.versionRelation)}</span>
                      <span>{formatPresentationMode(version.presentationMode)}</span>
                      <span>{formatAccessModel(version.accessModel)}</span>
                      <span>检查于 {version.checkedAt}</span>
                    </div>
                    <a href={version.url}>访问此版本</a>
                    {version.regionRestrictions?.map((restriction) => (
                      <p class="access-version-list__restriction">{formatRegionRestriction(restriction)}</p>
                    ))}
                  </li>
                ))}
              </ul>
              {relevanceDisplay.text && (
                <p class="work-item-result__relevance">
                  {relevanceDisplay.label && <strong>{relevanceDisplay.label}：</strong>}
                  {relevanceDisplay.text}
                </p>
              )}
              {resource.externalSignals && resource.externalSignals.length > 0 && (
                <section class="external-observations" aria-label={`${resource.title['zh-CN']} 的${externalObservationCopy.sectionTitle}`}>
                  <h4>{externalObservationCopy.sectionTitle}</h4>
                  <ul>
                    {resource.externalSignals.map((signal) => (
                      <li data-external-observation>
                        <a href={signal.url}>
                          <span>{signal.provider}</span>
                          <span>{signal.label}：{signal.value}</span>
                          {signal.sampleSize && <span>样本：{signal.sampleSize}</span>}
                          <span>观察于 {signal.observedAt}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              )}
            </div>
          </details>
        </article>
      );
    })}
  </div>
</section>
)}
