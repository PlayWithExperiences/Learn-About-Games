---
import { buildCapabilityMindMapLayout, relationSemantics } from '../lib/map-geometry';
import { sitePath } from '../lib/site-path';
import type { Catalog } from '../lib/catalog/validate';

interface Props {
  mapGroups: Catalog['mapGroups'];
  domains: Catalog['domains'];
  capabilities: Catalog['capabilities'];
  knowledgeTopics: Catalog['knowledgeTopics'];
  capabilityRelations: Catalog['capabilityRelations'];
}

const { mapGroups, domains, capabilities, knowledgeTopics, capabilityRelations } = Astro.props;
const layout = buildCapabilityMindMapLayout(mapGroups, domains, capabilities, knowledgeTopics);
const orderedGroups = [...mapGroups].sort(
  (left, right) => left.order - right.order || left.id.localeCompare(right.id),
);
const domainsById = new Map(domains.map((domain) => [domain.id, domain]));
const capabilitiesById = new Map(capabilities.map((capability) => [capability.id, capability]));
const capabilitiesByKey = new Map(
  capabilities.map((capability) => [`capability:${capability.id}` as const, capability]),
);
const topicsByKey = new Map(
  knowledgeTopics.map((topic) => [`knowledge-topic:${topic.id}` as const, topic]),
);
const textMapEntities = [
  ...capabilities.map((capability) => ({
    id: capability.id,
    domainId: capability.domainId,
    href: sitePath(`capabilities/${capability.id}/`),
    key: `capability:${capability.id}` as const,
    kind: 'capability' as const,
    kindLabel: '能力',
    name: capability.name['zh-CN'],
    position: capability.position,
  })),
  ...knowledgeTopics.map((topic) => ({
    id: topic.id,
    domainId: topic.domainId,
    href: sitePath(`topics/${topic.id}/`),
    key: `knowledge-topic:${topic.id}` as const,
    kind: 'knowledge-topic' as const,
    kindLabel: '知识议题',
    name: topic.name['zh-CN'],
    position: topic.position,
  })),
];
const boxesByKey = new Map(
  [layout.root, ...layout.groups, ...layout.domains, ...layout.nodes].map((box) => [box.key, box]),
);
const capabilityCentersById = new Map(
  layout.nodes
    .filter(({ kind }) => kind === 'capability')
    .map((box) => [box.id, { x: box.x + box.width / 2, y: box.y + box.height / 2 }]),
);

const relationLabel = (type: 'supports' | 'complements') =>
  type === 'supports' ? '支持' : '互补';

const relationDirection = (type: 'supports' | 'complements') =>
  relationSemantics[type].direction;

const boxStyle = (key: string) => {
  const box = boxesByKey.get(key as (typeof layout.root)['key']);
  if (!box) throw new Error(`Missing mind-map box: ${key}`);
  return `--box-x:${box.x}px;--box-y:${box.y}px;--box-width:${box.width}px;--box-height:${box.height}px`;
};
---

<section class="capability-map" aria-labelledby="capability-map-title">
  <div class="map-key" aria-label="地图图例与关系说明">
    <div>
      <h2 id="capability-map-title">地图图例</h2>
      <p>位置只表达领域归属与知识邻近，不表示价值、难度或学习顺序。</p>
    </div>
    <ul>
      <li><span class="map-key__capability" aria-hidden="true"></span><strong>能力</strong>：可通过实践逐步掌握</li>
      <li><span class="map-key__topic" aria-hidden="true"></span><strong>知识议题</strong>：值得理解的概念与语境</li>
      <li><span class="map-key__supports" aria-hidden="true"></span><strong>支持</strong>：有向支持不表示必修或固定学习顺序</li>
      <li><span class="map-key__complements" aria-hidden="true"></span><strong>互补</strong>：互补关系不表示先后</li>
    </ul>
  </div>

  <div
    class="capability-map__canvas"
    data-capability-map-canvas
    aria-label="能力地图桌面画布"
    style={`--map-height:${layout.height}px`}
  >
    <div
      class="capability-map__scene"
      style={`width:${layout.width}px;height:${layout.height}px`}
    >
      <div
        id="map-root-expertise-map-root"
        class="map-root-label map-layout-box"
        data-map-root
        data-map-key={layout.root.key}
        style={boxStyle(layout.root.key)}
      >
        <strong>Expertise Map</strong>
        <span>能力地图</span>
      </div>

      {orderedGroups.map((group) => (
        <section
          id={`map-group-${group.id}`}
          class="map-group-label map-layout-box"
          data-map-group={group.id}
          data-map-key={`group:${group.id}`}
          aria-label={group.name['zh-CN']}
          style={boxStyle(`group:${group.id}`)}
        >
          <h3>{group.name['zh-CN']}</h3>
        </section>
      ))}

      {layout.domains.map((domainBox) => {
        const domain = domainsById.get(domainBox.id);
        if (!domain) return null;
        return (
          <section
            id={`map-domain-${domain.id}`}
            class="map-domain-label map-layout-box"
            data-map-region={domain.id}
            data-map-key={domainBox.key}
            aria-labelledby={`map-domain-title-${domain.id}`}
            style={boxStyle(domainBox.key)}
          >
            <h3 id={`map-domain-title-${domain.id}`}>{domain.name['zh-CN']}</h3>
          </section>
        );
      })}

      <svg
        class="capability-map__structure"
        viewBox={`0 0 ${layout.width} ${layout.height}`}
        aria-hidden="true"
      >
        {layout.structuralPaths.map((structuralPath) => (
          <path
            d={structuralPath.path}
            data-map-structural-path={structuralPath.id}
            data-from-key={structuralPath.fromKey}
            data-to-key={structuralPath.toKey}
            vector-effect="non-scaling-stroke"
          ></path>
        ))}
      </svg>

      <svg
        class="capability-map__relations"
        viewBox={`0 0 ${layout.width} ${layout.height}`}
        role="img"
        aria-labelledby="map-relations-title map-relations-description"
      >
        <title id="map-relations-title">能力关系</title>
        <desc id="map-relations-description">支持关系有方向但不是先修顺序，互补关系没有方向。</desc>
        <defs>
          <marker id="support-arrow" viewBox="0 0 6 6" refX="5.25" refY="3" markerWidth="6" markerHeight="6" orient="auto-start-reverse" markerUnits="strokeWidth">
            <path d="M 0 0 L 6 3 L 0 6 Z"></path>
          </marker>
        </defs>
        {capabilityRelations.map((relation) => {
          const start = capabilityCentersById.get(relation.fromId);
          const end = capabilityCentersById.get(relation.toId);
          if (!start || !end) throw new Error(`Missing relation endpoint: ${relation.id}`);
          const midpoint = { x: (start.x + end.x) / 2, y: (start.y + end.y) / 2 };
          const direction = relationDirection(relation.type);
          return (
            <path
              class:list={['map-relation', `map-relation--${relation.type}`]}
              d={`M ${start.x} ${start.y} L ${midpoint.x} ${midpoint.y} L ${end.x} ${end.y}`}
              data-capability-relation={relation.id}
              data-relation-type={relation.type}
              data-direction={direction}
              data-from={relation.fromId}
              data-to={relation.toId}
              data-start-x={start.x}
              data-start-y={start.y}
              data-end-x={end.x}
              data-end-y={end.y}
              marker-mid={relation.type === 'supports' ? 'url(#support-arrow)' : undefined}
              vector-effect="non-scaling-stroke"
            >
              <title>{capabilitiesById.get(relation.fromId)?.name['zh-CN']} {relationLabel(relation.type)} {capabilitiesById.get(relation.toId)?.name['zh-CN']}：{relation.summary['zh-CN']}</title>
            </path>
          );
        })}
      </svg>

      <div class="capability-map__nodes">
        {layout.nodes.map((nodeBox) => {
          if (nodeBox.kind === 'capability') {
            const capability = capabilitiesByKey.get(nodeBox.key as `capability:${string}`);
            if (!capability) return null;
            return (
              <a
                id={`map-node-capability-${capability.id}`}
                class="map-node map-node--capability map-layout-box"
                href={sitePath(`capabilities/${capability.id}/`)}
                aria-label={capability.name['zh-CN']}
                data-map-node
                data-map-node-id={capability.id}
                data-map-node-kind="capability"
                data-map-key={nodeBox.key}
                data-career-node
                data-career-focus-target
                data-capability-id={capability.id}
                data-entity-label="能力"
                data-anchor-x={capability.position.x}
                data-anchor-y={capability.position.y}
                data-layout-center-x={nodeBox.x + nodeBox.width / 2}
                data-layout-center-y={nodeBox.y + nodeBox.height / 2}
                style={boxStyle(nodeBox.key)}
              >
                <span>{capability.name['zh-CN']}</span>
                <small class="career-node-role-label" data-role-label hidden></small>
              </a>
            );
          }
          const topic = topicsByKey.get(nodeBox.key as `knowledge-topic:${string}`);
          if (!topic) return null;
          return (
            <a
              id={`map-node-knowledge-topic-${topic.id}`}
              class="map-node map-node--topic map-layout-box"
              href={sitePath(`topics/${topic.id}/`)}
              aria-label={topic.name['zh-CN']}
              data-map-node
              data-map-node-id={topic.id}
              data-map-node-kind="knowledge-topic"
              data-map-key={nodeBox.key}
              data-entity-label="知识议题"
              data-anchor-x={topic.position.x}
              data-anchor-y={topic.position.y}
              data-layout-center-x={nodeBox.x + nodeBox.width / 2}
              data-layout-center-y={nodeBox.y + nodeBox.height / 2}
              style={boxStyle(nodeBox.key)}
            >
              <small>知识议题</small>
              <span>{topic.name['zh-CN']}</span>
            </a>
          );
        })}
      </div>
    </div>
  </div>

  <details class="capability-map__text" data-map-text-equivalent>
    <summary>地图结构与关系文字版</summary>
    <div class="capability-map__text-body">
      <section aria-labelledby="map-text-structure-title">
        <h2 id="map-text-structure-title">Expertise Map 结构</h2>
        <ol class="map-text-groups">
          {orderedGroups.map((group) => {
            const orderedDomains = group.domainIds
              .map((domainId) => domainsById.get(domainId))
              .filter((domain): domain is Catalog['domains'][number] => Boolean(domain))
              .sort((left, right) => left.order - right.order || left.id.localeCompare(right.id));
            return (
              <li
                id={`map-text-group-${group.id}`}
                data-text-map-group={group.id}
                data-map-key={`group:${group.id}`}
              >
                <h3>{group.name['zh-CN']}</h3>
                <p>{group.summary['zh-CN']}</p>
                <ol>
                  {orderedDomains.map((domain) => {
                    const entities = textMapEntities
                      .filter(({ domainId }) => domainId === domain.id)
                      .sort((left, right) => left.position.y - right.position.y
                        || left.position.x - right.position.x
                        || left.id.localeCompare(right.id));
                    return (
                      <li
                        id={`map-text-domain-${domain.id}`}
                        data-text-map-domain={domain.id}
                        data-map-key={`domain:${domain.id}`}
                      >
                        <h4><span>Domain</span>{domain.name['zh-CN']}</h4>
                        <ul>
                          {entities.map((entity) => (
                            <li
                              id={`map-text-node-${entity.kind}-${entity.id}`}
                              data-text-map-node-kind={entity.kind}
                              data-map-key={entity.key}
                            >
                              <span>{entity.kindLabel}</span>
                              <a href={entity.href}>{entity.name}</a>
                            </li>
                          ))}
                        </ul>
                      </li>
                    );
                  })}
                </ol>
              </li>
            );
          })}
        </ol>
      </section>

      <section aria-labelledby="map-text-relations-title">
        <h2 id="map-text-relations-title">能力关系</h2>
        <p>支持关系有方向但不是先修顺序，互补关系没有方向。</p>
        <ol class="map-text-relations">
          {capabilityRelations.map((relation) => (
            <li
              id={`map-text-relation-${relation.id}`}
              data-text-map-relation={relation.id}
              data-from-key={`capability:${relation.fromId}`}
              data-to-key={`capability:${relation.toId}`}
            >
              <p>
                <a href={sitePath(`capabilities/${relation.fromId}/`)}>{capabilitiesById.get(relation.fromId)?.name['zh-CN']}</a>
                <strong>{relationLabel(relation.type)}</strong>
                <a href={sitePath(`capabilities/${relation.toId}/`)}>{capabilitiesById.get(relation.toId)?.name['zh-CN']}</a>
              </p>
              <p>{relation.summary['zh-CN']}</p>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </details>

  <div class="capability-map__outline" data-mobile-map-outline aria-label="能力地图关系大纲">
    <p class="capability-map__outline-note">有向支持不表示必修或固定学习顺序；互补关系不表示先后。</p>
    {orderedGroups.map((group) => {
      const orderedDomains = group.domainIds
        .map((domainId) => domainsById.get(domainId))
        .filter((domain): domain is Catalog['domains'][number] => Boolean(domain))
        .sort((left, right) => left.order - right.order || left.id.localeCompare(right.id));
      return (
        <section class="map-outline-group" data-outline-group={group.id}>
          <header class="map-outline-group__heading">
            <h2>{group.name['zh-CN']}</h2>
            <p>{group.summary['zh-CN']}</p>
          </header>
          {orderedDomains.map((domain) => {
            const domainCapabilities = capabilities
              .filter(({ domainId }) => domainId === domain.id)
              .sort((left, right) => left.position.y - right.position.y
                || left.position.x - right.position.x
                || left.id.localeCompare(right.id));
            const domainTopics = knowledgeTopics
              .filter(({ domainId }) => domainId === domain.id)
              .sort((left, right) => left.position.y - right.position.y
                || left.position.x - right.position.x
                || left.id.localeCompare(right.id));
            return (
              <section class="map-outline-region" data-outline-region={domain.id}>
                <div class="map-outline-region__heading">
                  <h3>{domain.name['zh-CN']}</h3>
                  <p>{domain.summary['zh-CN']}</p>
                </div>

                <div class="map-outline-region__nodes">
            {domainCapabilities.map((capability) => {
              const outgoing = capabilityRelations.filter(
                ({ type, fromId }) => type === 'supports' && fromId === capability.id,
              );
              const incoming = capabilityRelations.filter(
                ({ type, toId }) => type === 'supports' && toId === capability.id,
              );
              const complements = capabilityRelations.filter(
                ({ type, fromId, toId }) =>
                  type === 'complements' && (fromId === capability.id || toId === capability.id),
              );
              return (
                <div
                  class="map-outline-node"
                  data-outline-node-kind="capability"
                  data-career-node
                  data-capability-id={capability.id}
                >
                  <div class="map-outline-node__heading">
                    <span>能力</span>
                    <a
                      href={sitePath(`capabilities/${capability.id}/`)}
                      data-career-focus-target
                      data-capability-id={capability.id}
                    >{capability.name['zh-CN']}</a>
                    <small class="career-node-role-label" data-role-label hidden></small>
                  </div>
                  <details>
                    <summary>查看关系</summary>
                    <p class="map-outline-node__summary">
                      <strong>能力简介</strong>
                      <span>{capability.summary['zh-CN']}</span>
                    </p>
                    <div class="map-outline-node__relations">
                      <section>
                        <h3>它支持</h3>
                        {outgoing.length > 0 ? (
                          <ul>
                            {outgoing.map((relation) => (
                              <li data-node-relation={relation.id}>
                                <a href={sitePath(`capabilities/${relation.toId}/`)}>{capabilitiesById.get(relation.toId)?.name['zh-CN']}</a>
                                <span>{relation.summary['zh-CN']}</span>
                              </li>
                            ))}
                          </ul>
                        ) : <p>当前没有记录直接支持的能力。</p>}
                      </section>
                      <section>
                        <h3>受到支持</h3>
                        {incoming.length > 0 ? (
                          <ul>
                            {incoming.map((relation) => (
                              <li data-node-relation={relation.id}>
                                <a href={sitePath(`capabilities/${relation.fromId}/`)}>{capabilitiesById.get(relation.fromId)?.name['zh-CN']}</a>
                                <span>{relation.summary['zh-CN']}</span>
                              </li>
                            ))}
                          </ul>
                        ) : <p>当前没有记录直接支持它的能力。</p>}
                      </section>
                      <section>
                        <h3>互补</h3>
                        {complements.length > 0 ? (
                          <ul>
                            {complements.map((relation) => {
                              const otherId = relation.fromId === capability.id ? relation.toId : relation.fromId;
                              return (
                                <li data-node-relation={relation.id}>
                                  <a href={sitePath(`capabilities/${otherId}/`)}>{capabilitiesById.get(otherId)?.name['zh-CN']}</a>
                                  <span>{relation.summary['zh-CN']}</span>
                                </li>
                              );
                            })}
                          </ul>
                        ) : <p>当前没有记录互补能力。</p>}
                      </section>
                    </div>
                  </details>
                </div>
              );
            })}

            {domainTopics.map((topic) => (
              <div class="map-outline-node map-outline-node--topic" data-outline-node-kind="knowledge-topic">
                <div class="map-outline-node__heading">
                  <span>知识议题</span>
                  <a href={sitePath(`topics/${topic.id}/`)}>{topic.name['zh-CN']}</a>
                </div>
                <details>
                  <summary>查看摘要</summary>
                  <p class="map-outline-node__summary">{topic.summary['zh-CN']}</p>
                </details>
              </div>
            ))}
                </div>
              </section>
            );
          })}
        </section>
      );
    })}
  </div>
</section>

<script>
  const canvas = document.querySelector<HTMLElement>('[data-capability-map-canvas]');

  const clearAdjacency = () => {
    canvas?.querySelectorAll<HTMLElement>('[data-adjacent]').forEach((element) => {
      delete element.dataset.adjacent;
    });
  };

  const showAdjacency = (nodeId: string) => {
    clearAdjacency();
    const adjacentIds = new Set([nodeId]);
    canvas?.querySelectorAll<SVGPathElement>('[data-capability-relation]').forEach((edge) => {
      if (edge.dataset.from === nodeId || edge.dataset.to === nodeId) {
        edge.dataset.adjacent = 'true';
        if (edge.dataset.from) adjacentIds.add(edge.dataset.from);
        if (edge.dataset.to) adjacentIds.add(edge.dataset.to);
      }
    });
    adjacentIds.forEach((id) => {
      const node = canvas?.querySelector<HTMLElement>(`[data-map-node-id="${id}"]`);
      if (node) node.dataset.adjacent = 'true';
    });
  };

  canvas?.querySelectorAll<HTMLElement>('[data-map-node]').forEach((node) => {
    const nodeId = node.dataset.mapNodeId;
    if (!nodeId) return;
    node.addEventListener('pointerenter', () => showAdjacency(nodeId));
    node.addEventListener('pointerleave', clearAdjacency);
    node.addEventListener('focus', () => showAdjacency(nodeId));
    node.addEventListener('blur', clearAdjacency);
  });
</script>
