---
import type { Catalog } from '../lib/catalog/validate';

type AtlasEvidence = Catalog['atlasEvidence'][number];
type AtlasNode = Catalog['atlasNodes'][number];
type AtlasRelation = Catalog['atlasRelations'][number];
type AtlasTag = Catalog['atlasTags'][number];
type AtlasTheme = Catalog['atlasThemes'][number];

interface Props {
  evidence: AtlasEvidence[];
  nodes: AtlasNode[];
  relations: AtlasRelation[];
  tags: AtlasTag[];
  themes: AtlasTheme[];
}

const { evidence, nodes, relations, tags, themes } = Astro.props;
const nodeById = new Map(nodes.map((node) => [node.id, node]));
const evidenceById = new Map(evidence.map((item) => [item.id, item]));
const games = nodes
  .filter((node) => node.kind === 'game')
  .sort((a, b) => a.startYear - b.startYear || a.lane - b.lane);
const conceptNodes = nodes
  .filter((node) => node.kind !== 'game')
  .sort((a, b) => a.startYear - b.startYear || a.lane - b.lane);

const relationLabels: Record<AtlasRelation['type'], string> = {
  'derived-variant': '派生变体',
  'direct-influence': '直接影响',
  fusion: '融合',
  revival: '复兴或重新流行',
  'parallel-origin': '平行或独立产生',
  'structural-similarity': '结构相似但影响未知',
  disputed: '存在争议',
};

const statusLabels: Record<AtlasRelation['status'], string> = {
  confirmed: '已直接支持',
  credible: '可信历史综合',
  inferred: '推断',
  disputed: '有争议',
};

const kindLabels: Record<AtlasNode['kind'], string> = {
  game: 'Game',
  innovation: 'Innovation',
  category: 'Category Formation',
};
---

<section class="atlas-framework page-shell" aria-labelledby="atlas-framework-title">
  <div class="atlas-section-heading">
    <h2 id="atlas-framework-title">共享标签 taxonomy</h2>
    <p>Node、Relation 与 Theme 使用同一份标签；主题只改变强调，不拥有或删减全局图。</p>
  </div>
  <ol class="atlas-category-index">
    {tags.map((tag) => (
      <li>
        <span data-atlas-tag={tag.id}>{tag.name['zh-CN']}</span>
        <p>{tag.summary['zh-CN']}</p>
      </li>
    ))}
  </ol>
</section>

<article class="atlas-theme page-shell" aria-labelledby="atlas-theme-title">
  <header class="atlas-theme__header">
    <p class="plain-label">全局数据迁移过渡视图</p>
    <h2 id="atlas-theme-title">{nodes.length} 个节点 · {relations.length} 条有证据关系</h2>
    <p>当前透镜：{themes.map((theme) => theme.title['zh-CN']).join('、')}。本页暂时完整列出所有实体，网络交互将在下一任务替换。</p>
  </header>

  <section class="atlas-concept" aria-labelledby="atlas-concept-title">
    <div>
      <p class="atlas-entity-label">Innovation / Category Formation</p>
      <h3 id="atlas-concept-title">概念与类别形成节点</h3>
    </div>
    <div class="atlas-concept__boundary">
      <p>Game 只使用发行年份；Category Formation 显示时间范围。</p>
      <p>时间相邻、主题命中或同处一条时间轴都不会自动产生关系。</p>
    </div>
    {conceptNodes.map((node) => (
      <div class="atlas-concept__node" data-atlas-node-kind={node.kind} data-atlas-node-id={node.id}>
        <p class="atlas-entity-label">{kindLabels[node.kind]}</p>
        <time datetime={String(node.startYear)}>
          {node.endYear ? `${node.startYear}–${node.endYear}` : node.startYear}
        </time>
        <h3>{node.name['zh-CN']}</h3>
        <p>{node.summary['zh-CN']}</p>
      </div>
    ))}
  </section>

  <section class="atlas-chronology" aria-labelledby="atlas-chronology-title">
    <div class="atlas-section-heading">
      <h3 id="atlas-chronology-title">全局 Game 年代顺序</h3>
      <p>年份只负责排列，不用于证明第一款、直接影响或类别成员资格。</p>
    </div>
    <ol class="atlas-game-timeline">
      {games.map((game) => (
        <li data-atlas-node-kind="game" data-atlas-node-id={game.id}>
          <p class="atlas-entity-label">Game</p>
          <time datetime={String(game.startYear)}>{game.startYear}</time>
          <strong data-atlas-node-name>{game.name['zh-CN']}</strong>
          <p>{game.summary['zh-CN']}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="atlas-relations" aria-labelledby="atlas-relations-title">
    <div class="atlas-section-heading">
      <h3 id="atlas-relations-title">{relations.length} 条有证据关系</h3>
      <p>方向、类型、状态与 evidence 均来自数据契约；无向相似关系不显示因果箭头。</p>
    </div>
    <div class="atlas-relation-grid">
      {relations.map((relation) => {
        const from = nodeById.get(relation.fromId);
        const to = nodeById.get(relation.toId);
        const relationEvidence = relation.evidenceIds
          .map((id) => evidenceById.get(id))
          .filter((item): item is AtlasEvidence => Boolean(item));

        return (
          <article
            data-atlas-relation={relation.id}
            data-from-id={relation.fromId}
            data-to-id={relation.toId}
            data-relation-type={relation.type}
            data-relation-directionality={relation.directionality}
          >
            <div class="atlas-relation__path">
              <span data-endpoint-kind={from?.kind}>{from?.name['zh-CN']}</span>
              <b>
                <span class="atlas-relation__arrow" data-atlas-direction-arrow aria-hidden="true">
                  {relation.directionality === 'directed' ? '→' : '↔'}
                </span>
                <span>{relationLabels[relation.type]}</span>
              </b>
              <span data-endpoint-kind={to?.kind}>{to?.name['zh-CN']}</span>
            </div>
            <p>{relation.summary['zh-CN']}</p>
            <div class="atlas-relation__evidence">
              <span data-evidence-status={relation.status}>证据状态：{statusLabels[relation.status]}</span>
              {relationEvidence.map((item) => (
                <a href={item.url} target="_blank" rel="noreferrer" data-atlas-evidence-link>
                  查看证据：{item.title['zh-CN']}
                </a>
              ))}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="atlas-evidence-index" aria-labelledby="atlas-evidence-title">
    <div class="atlas-section-heading">
      <h3 id="atlas-evidence-title">Evidence 索引</h3>
      <p>Evidence 保持为文献条目，不与 Game、Innovation 或 Category Formation 共用节点形状。</p>
    </div>
    <ol>
      {evidence.map((item) => (
        <li data-atlas-evidence={item.id}>
          <span class="atlas-entity-label">Evidence</span>
          <a href={item.url} target="_blank" rel="noreferrer" data-atlas-evidence-link>
            {item.title['zh-CN']}
          </a>
          <p>{item.summary['zh-CN']}</p>
        </li>
      ))}
    </ol>
  </section>
</article>
