---
import { sitePath } from '../lib/site-path';
import type { Catalog } from '../lib/catalog/validate';

interface Props {
  domains: Catalog['domains'];
  capabilities: Catalog['capabilities'];
}

const { domains, capabilities } = Astro.props;
const orderedDomains = [...domains].sort((a, b) => a.order - b.order);
---

<div class="map-explorer" aria-label="能力地图">
  {orderedDomains.map((domain) => {
    const domainCapabilities = capabilities.filter(
      (capability) => capability.domainId === domain.id,
    );

    return (
      <section class="domain-region" aria-labelledby={`domain-${domain.id}`}>
        <div class="domain-region__heading">
          <h2 id={`domain-${domain.id}`}>{domain.name['zh-CN']}</h2>
          <p>{domain.summary['zh-CN']}</p>
        </div>
        <div class="capability-list">
          {domainCapabilities.map((capability) => {
            const isCurated = capability.id === 'playtesting';
            const labelId = `capability-${capability.id}-label`;
            const summaryId = `capability-${capability.id}-summary`;
            const statusId = `capability-${capability.id}-status`;

            return isCurated ? (
              <a
                class:list={['capability-node', 'capability-node--next']}
                id={capability.id}
                href={sitePath('capabilities/playtesting/')}
                aria-labelledby={labelId}
                aria-describedby={`${summaryId} ${statusId}`}
              >
                <strong id={labelId}>{capability.name['zh-CN']}</strong>
                <span id={summaryId}>{capability.summary['zh-CN']}</span>
                <small id={statusId}>查看已策展路径</small>
              </a>
            ) : (
              <div class="capability-node" id={capability.id}>
                <strong>{capability.name['zh-CN']}</strong>
                <span>{capability.summary['zh-CN']}</span>
                <small>路径尚未策展</small>
              </div>
            );
          })}
        </div>
      </section>
    );
  })}
</div>
